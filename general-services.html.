<!-- =====================================================
     GENERAL SERVICES LOGIC
====================================================== -->

<script type="module">


/* =====================================================
   FIREBASE
===================================================== */

import {
    auth,
    database
} from "./firebase.js";


import {
    onAuthStateChanged
} from "https://www.gstatic.com/firebasejs/12.2.1/firebase-auth.js";


import {
    ref,
    get
} from "https://www.gstatic.com/firebasejs/12.2.1/firebase-database.js";



/* =====================================================
   GENERAL SERVICE CATALOGUE
===================================================== */

import {
    hkdmservicesOfficialServicePriceCatalogue
} from "./services.js";



/* =====================================================
   ELEMENTS
===================================================== */

const servicesContainer =
    document.getElementById(
        "servicesContainer"
    );


const noServices =
    document.getElementById(
        "noServices"
    );


const serviceSearch =
    document.getElementById(
        "serviceSearch"
    );


const serviceCount =
    document.getElementById(
        "serviceCount"
    );


const tierName =
    document.getElementById(
        "tierName"
    );


const platformFilters =
    document.getElementById(
        "platformFilters"
    );



/* =====================================================
   VARIABLES
===================================================== */

let currentTier =
    "regular";


let currentPlatform =
    "all";


let currentSearch =
    "";


let allServices =
    [];



/* =====================================================
   BUILD GENERAL CATALOGUE
===================================================== */

function buildCatalogue() {

    const generalServices =

        Array.isArray(
            hkdmservicesOfficialServicePriceCatalogue
        )

            ? hkdmservicesOfficialServicePriceCatalogue

            : [];


    allServices =

        generalServices.map(
            service => ({

                ...service,

                catalogue: "general"

            })
        );

}



/* =====================================================
   FORMAT NAIRA
===================================================== */

function formatNaira(amount) {

    return new Intl.NumberFormat(
        "en-NG",
        {
            style: "currency",
            currency: "NGN",
            minimumFractionDigits: 2
        }
    ).format(
        Number(
            amount || 0
        )
    );

}



/* =====================================================
   GET ACTIVE PRICE
===================================================== */

function getServicePrice(service) {

    const tier =

        String(
            currentTier ||
            "regular"
        ).toLowerCase();


    if (

        tier === "reseller" &&

        service.resellerRatePer1000 !==
            undefined

    ) {

        return service.resellerRatePer1000;

    }


    if (

        tier === "vip" &&

        service.vipRatePer1000 !==
            undefined

    ) {

        return service.vipRatePer1000;

    }


    return service.ratePer1000 || 0;

}



/* =====================================================
   LOAD USER TIER
===================================================== */

async function loadUserTier(user) {

    try {

        const userRef =

            ref(
                database,
                `users/${user.uid}`
            );


        const snapshot =

            await get(
                userRef
            );


        if (
            snapshot.exists()
        ) {

            const userData =
                snapshot.val();


            currentTier =

                String(
                    userData.tier ||
                    "regular"
                ).toLowerCase();

        }

    } catch (error) {

        console.error(
            "Unable to load user tier:",
            error
        );


        currentTier =
            "regular";

    }


    tierName.textContent =
        currentTier.toUpperCase();

}



/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHtml(value) {

    return String(
        value ?? ""
    )

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );

}



/* =====================================================
   UPDATE PLATFORM FILTERS
===================================================== */

function updatePlatformFilters() {

    const platforms = [

        ...new Set(

            allServices

                .map(
                    service =>
                        service.platform
                )

                .filter(Boolean)

        )

    ];


    platformFilters.innerHTML =
        "";


    const allButton =
        document.createElement(
            "button"
        );


    allButton.type =
        "button";


    allButton.className =
        "btn btn-success platform-btn active";


    allButton.dataset.platform =
        "all";


    allButton.textContent =
        "All Platforms";


    platformFilters.appendChild(
        allButton
    );


    platforms.forEach(
        platform => {

            const button =
                document.createElement(
                    "button"
                );


            button.type =
                "button";


            button.className =
                "btn btn-outline-success platform-btn";


            button.dataset.platform =
                platform;


            button.textContent =
                platform;


            platformFilters.appendChild(
                button
            );

        }
    );


    currentPlatform =
        "all";


    attachPlatformEvents();

}



/* =====================================================
   PLATFORM EVENTS
===================================================== */

function attachPlatformEvents() {

    document
        .querySelectorAll(
            ".platform-btn"
        )
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    () => {

                        document
                            .querySelectorAll(
                                ".platform-btn"
                            )
                            .forEach(
                                btn => {

                                    btn.classList.remove(
                                        "active"
                                    );


                                    btn.classList.remove(
                                        "btn-success"
                                    );


                                    btn.classList.add(
                                        "btn-outline-success"
                                    );

                                }
                            );


                        button.classList.add(
                            "active"
                        );


                        button.classList.remove(
                            "btn-outline-success"
                        );


                        button.classList.add(
                            "btn-success"
                        );


                        currentPlatform =
                            button.dataset.platform;


                        renderServices();

                    }
                );

            }
        );

}



/* =====================================================
   FILTER SERVICES
===================================================== */

function getFilteredServices() {

    const search =

        currentSearch.toLowerCase();


    return allServices.filter(
        service => {

            const platformMatch =

                currentPlatform === "all" ||

                String(
                    service.platform || ""
                ).toLowerCase() ===

                    currentPlatform.toLowerCase();


            const searchableText =

                String(
                    service.platform || ""
                ).toLowerCase()

                + " " +

                String(
                    service.service || ""
                ).toLowerCase()

                + " " +

                String(
                    service.id || ""
                ).toLowerCase();


            const searchMatch =

                !search ||

                searchableText.includes(
                    search
                );


            return (

                platformMatch &&

                searchMatch

            );

        }
    );

}



/* =====================================================
   RENDER SERVICES
===================================================== */

function renderServices() {

    const services =
        getFilteredServices();


    serviceCount.textContent =

        `${services.length} Services`;


    servicesContainer.innerHTML =
        "";


    if (
        services.length === 0
    ) {

        noServices.classList.remove(
            "d-none"
        );

        return;

    }


    noServices.classList.add(
        "d-none"
    );


    services.forEach(
        service => {

            const card =
                document.createElement(
                    "div"
                );


            card.className =
                "col-12 col-md-6 col-lg-4";


            const price =
                getServicePrice(
                    service
                );


            const regularRate =
                Number(
                    service.ratePer1000 ||
                    0
                );


            const resellerRate =
                service.resellerRatePer1000;


            const vipRate =
                service.vipRatePer1000;



            card.innerHTML = `

                <div
                    class="card
                    h-100
                    shadow-sm
                    border-0"
                >

                    <div
                        class="card-body"
                    >


                        <!-- SERVICE HEADER -->

                        <div
                            class="d-flex
                            justify-content-between
                            align-items-start
                            mb-3"
                        >

                            <div
                                class="d-flex
                                flex-wrap
                                gap-1"
                            >

                                <span
                                    class="badge bg-dark"
                                >

                                    ${escapeHtml(
                                        service.platform ||
                                        "Social Media"
                                    )}

                                </span>


                                <span
                                    class="badge bg-primary"
                                >

                                    General

                                </span>

                            </div>


                            <small
                                class="text-muted"
                            >

                                #${escapeHtml(
                                    service.id || ""
                                )}

                            </small>

                        </div>



                        <!-- SERVICE NAME -->

                        <h5 class="fw-bold">

                            ${escapeHtml(
                                service.service ||
                                "Service"
                            )}

                        </h5>



                        <!-- DESCRIPTION -->

                        <p
                            class="text-muted
                            small"
                        >

                            ${escapeHtml(
                                service.description ||

                                `${service.service || "Service"} service for ${service.platform || "social media"}.`
                            )}

                        </p>


                        <hr>



                        <!-- PRICE -->

                        <div class="mb-3">

                            <small
                                class="text-muted d-block"
                            >

                                Price per 1,000

                            </small>


                            <div
                                class="fs-4
                                fw-bold
                                text-success"
                            >

                                ${formatNaira(
                                    price
                                )}

                            </div>

                        </div>



                        <!-- REGULAR PRICE FOR HIGHER TIERS -->

                        ${
                            currentTier !== "regular" &&
                            price !== regularRate

                                ? `

                                    <small
                                        class="text-muted
                                        d-block"
                                    >

                                        Regular:
                                        ${formatNaira(
                                            regularRate
                                        )}

                                    </small>

                                  `

                                : ""
                        }



                        <!-- DISCOUNT PRICES -->

                        ${
                            currentTier === "regular" &&
                            (
                                resellerRate !==
                                    undefined ||

                                vipRate !==
                                    undefined
                            )

                                ? `

                                    <div
                                        class="small
                                        text-muted"
                                    >

                                        ${
                                            resellerRate !==
                                                undefined

                                                ? `

                                                    Reseller:
                                                    ${formatNaira(
                                                        resellerRate
                                                    )}

                                                  `

                                                : ""
                                        }


                                        ${
                                            vipRate !==
                                                undefined

                                                ? `

                                                    <br>

                                                    VIP:
                                                    ${formatNaira(
                                                        vipRate
                                                    )}

                                                  `

                                                : ""
                                        }

                                    </div>

                                  `

                                : ""
                        }



                        <!-- ORDER BUTTON -->

                        <button
                            type="button"
                            class="btn btn-success w-100 mt-4 order-service-btn"
                            data-service-id="${escapeHtml(
                                service.id || ""
                            )}"
                            data-catalogue="general"
                            data-platform="${escapeHtml(
                                service.platform || ""
                            )}"
                        >

                            <i
                                class="bi bi-cart-plus"
                            ></i>

                            Order Service

                        </button>

                    </div>

                </div>

            `;


            servicesContainer.appendChild(
                card
            );

        }
    );


    attachOrderButtons();

}



/* =====================================================
   ORDER BUTTONS
===================================================== */

function attachOrderButtons() {

    document
        .querySelectorAll(
            ".order-service-btn"
        )
        .forEach(
            button => {

                button.addEventListener(
                    "click",
                    () => {

                        const serviceId =
                            button.dataset.serviceId;


                        const catalogue =
                            button.dataset.catalogue;


                        const platform =
                            button.dataset.platform;


                        window.location.href =

                            `order.html?service=${encodeURIComponent(
                                serviceId
                            )}&platform=${encodeURIComponent(
                                platform
                            )}&catalogue=${encodeURIComponent(
                                catalogue
                            )}`;

                    }
                );

            }
        );

}



/* =====================================================
   SEARCH
===================================================== */

serviceSearch.addEventListener(
    "input",
    () => {

        currentSearch =
            serviceSearch.value.trim();


        renderServices();

    }
);



/* =====================================================
   AUTHENTICATION
===================================================== */

onAuthStateChanged(
    auth,
    async user => {

        if (!user) {

            window.location.href =
                "login.html";

            return;

        }


        buildCatalogue();


        await loadUserTier(
            user
        );


        updatePlatformFilters();


        renderServices();

    }
);

</script>


</body>

